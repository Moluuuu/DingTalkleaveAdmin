# 仅部署模板：安全填写生产现有值后存为 /etc/leaveadmin/leaveadmin.env，权限0600。
# 不得将填写后的文件提交Git。API和scheduler使用同一文件。
LEAVEADMIN_HOME=/opt/yida/leaveAdmin
LEAVEADMIN_DB_PATH=/opt/yida/leaveAdmin/admin.db
LEAVEADMIN_CONFIG=/opt/yida/leaveAdmin/config.json
LEAVEADMIN_CONSTANTS=/opt/yida/leaveAdmin/constants.yaml
LEAVEADMIN_AUTH_PASSWORD=
DINGTALK_NOTIFY_USERID=
DINGTALK_ROBOT_CODE=
